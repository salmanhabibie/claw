# Salin file ini menjadi secrets.yaml (di folder yang sama dengan stella-diffuser.yaml)
# lalu isi nilai di bawah. JANGAN commit secrets.yaml ke git.

wifi_ssid: "nama-wifi-kamu"
wifi_password: "password-wifi-kamu"
fallback_ap_password: "password-hotspot-cadangan"

# Generate sekali lewat: esphome secrets stella-diffuser.yaml (atau ambil dari Home Assistant)
# 32 byte, base64-encoded
api_encryption_key: "GANTI_DENGAN_KEY_BASE64_32BYTE"

ota_password: "password-ota-kamu"
