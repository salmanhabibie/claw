menu "AI Assistant Configuration"

    config WIFI_SSID
        string "WiFi SSID"
        default "myssid"
        help
            Name of the 2.4 GHz WiFi network to connect to.

    config WIFI_PASSWORD
        string "WiFi Password"
        default "mypassword"
        help
            Password of the WiFi network. Leave empty for an open network.

    config CLAUDE_API_KEY
        string "Anthropic API key"
        default ""
        help
            Your Anthropic API key (starts with sk-ant-...).
            Get one at https://console.anthropic.com.
            NOTE: this is compiled into the firmware. Only flash it to a
            device you control, and don't commit a real key to git.

    config CLAUDE_MODEL
        string "Claude model ID"
        default "claude-opus-4-8"
        help
            Which Claude model to call. Examples:
              claude-opus-4-8   - most capable (default)
              claude-haiku-4-5  - cheapest and fastest, great for a tiny device

    config CLAUDE_MAX_TOKENS
        int "Max response tokens"
        default 1024
        range 64 4096
        help
            Upper bound on the length of Claude's reply. Smaller values keep
            the on-device response buffer small.

    choice
        prompt "LLM (brain) provider"
        default LLM_PROVIDER_ANTHROPIC
        help
            Which API generates the assistant's replies and tool calls.

        config LLM_PROVIDER_ANTHROPIC
            bool "Anthropic (Claude)"
        config LLM_PROVIDER_OPENAI
            bool "OpenAI-compatible (OpenAI / Groq / etc.)"
    endchoice

    config LLM_OPENAI_URL
        string "OpenAI-compatible chat completions URL"
        default "https://api.openai.com/v1/chat/completions"
        help
            Full chat-completions URL. OpenAI default shown. Groq:
            https://api.groq.com/openai/v1/chat/completions

    config LLM_OPENAI_MODEL
        string "OpenAI-compatible chat model"
        default "gpt-4o-mini"
        help
            Chat model. OpenAI: gpt-4o-mini (cheap/fast) or gpt-4o (smarter).
            Reuses the OpenAI-compatible API key set under the STT section.

    config ELEVENLABS_API_KEY
        string "ElevenLabs API key"
        default ""
        help
            Your ElevenLabs API key, used for text-to-speech (and later
            speech-to-text). Compiled into the firmware via the git-ignored
            sdkconfig. Do not commit a real key.

    config ELEVENLABS_VOICE_ID
        string "ElevenLabs voice ID"
        default "21m00Tcm4TlvDq8ikWAM"
        help
            Which ElevenLabs voice to speak with. The default is a built-in
            voice. Browse voices in the ElevenLabs dashboard for others.

    config ELEVENLABS_MODEL
        string "ElevenLabs TTS model"
        default "eleven_multilingual_v2"
        help
            TTS model. eleven_multilingual_v2 supports Indonesian and many
            other languages.

    choice
        prompt "Speech-to-text (STT) provider"
        default STT_PROVIDER_ELEVENLABS
        help
            Which service transcribes the microphone audio.

        config STT_PROVIDER_ELEVENLABS
            bool "ElevenLabs (scribe)"
        config STT_PROVIDER_OPENAI
            bool "OpenAI-compatible (OpenAI / Venice / Groq)"
    endchoice

    config OPENAI_API_KEY
        string "OpenAI-compatible API key (Bearer)"
        default ""
        help
            API key for the OpenAI-compatible STT endpoint (OpenAI sk-...,
            Venice, Groq, etc.). Used only when that STT provider is selected.
            Compiled into the firmware via sdkconfig; do not commit a real key.

    config STT_OPENAI_URL
        string "OpenAI-compatible STT endpoint URL"
        default "https://api.openai.com/v1/audio/transcriptions"
        help
            Full transcription URL. OpenAI default shown. Groq:
            https://api.groq.com/openai/v1/audio/transcriptions
            Venice: https://api.venice.ai/api/v1/audio/transcriptions

    config STT_OPENAI_MODEL
        string "OpenAI-compatible STT model"
        default "gpt-4o-mini-transcribe"
        help
            OpenAI: gpt-4o-mini-transcribe or whisper-1. Groq: whisper-large-v3.
            Venice: e.g. nvidia/parakeet-tdt-0.6b-v3.

    config STT_LANGUAGE
        string "STT language hint (ISO-639-1, blank = auto)"
        default "id"
        help
            Optional language hint sent to the STT, e.g. id for Indonesian.
            Leave blank to auto-detect.

    config HA_BASE_URL
        string "Home Assistant base URL"
        default ""
        help
            Base URL of your Home Assistant, e.g. http://192.168.0.10:8123
            (no trailing slash). Leave empty to disable smart-home control.

    config HA_TOKEN
        string "Home Assistant long-lived token"
        default ""
        help
            A Home Assistant long-lived access token (Profile -> Security ->
            Long-lived access tokens). Compiled into the firmware; do not
            commit a real token.

    config VEE_WAKE_WORD
        bool "Enable hands-free wake word (esp-sr WakeNet)"
        default n
        help
            Listen continuously for a wake phrase (e.g. "Alexa") so a
            conversation can start without tapping. Requires the esp-sr
            component, a 'model' partition, and a wake word selected under
            "ESP Speech Recognition". If disabled, only tap-to-talk is used.

            If the build or wake word misbehaves, set this to 'n' to fall
            back to the known-good tap-only firmware.

endmenu
